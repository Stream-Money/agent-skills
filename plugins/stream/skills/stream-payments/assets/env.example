# Stream credentials — copy to your project's .env (and add .env to .gitignore).
# Sandbox and production values are DIFFERENT; never mix them.
# Sandbox: https://app-demo.stream.money   Production: https://app.stream.money (see wl-config.md)

STREAM_API_URL=https://app-demo.stream.money
STREAM_API_KEY=            # Shop API Key (Bearer) — server-side only, never expose to the browser
STREAM_SIGNING_KEY=        # Shop Signing Key — webhook signature verification
